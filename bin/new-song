#!/usr/bin/env bash
#
# new-song — create or re-wire a track repo for one song.
#
# A track repo holds song content and stays private. This scaffold holds the tooling
# and stays shareable. The two are separate git repos, so a Claude Code session started
# in a track repo sees none of this repo's CLAUDE.md, agents or slash commands until
# something wires them together. That wiring is what this script does.
#
# Usage:
#   bin/new-song <song-name>
#   bin/new-song <song-name> --songs-dir /path/to/songs/root
#   bin/new-song <song-name> --relink          # re-wire an existing repo, touch nothing else
#
# Safe to re-run. It never overwrites a file you have edited: hand-written documents are
# created only when missing, and the symlinks are rebuilt every time.

set -euo pipefail

SCAFFOLD="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

song=""
songs_dir="${ABLETON_SONGS_DIR:-}"
relink_only=0

while [ $# -gt 0 ]; do
    case "$1" in
        --songs-dir) songs_dir="${2:-}"; shift 2 ;;
        --relink)    relink_only=1; shift ;;
        -h|--help)   sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)          echo "Unknown option: $1" >&2; exit 2 ;;
        *)           song="$1"; shift ;;
    esac
done

if [ -z "$song" ]; then
    echo "Usage: bin/new-song <song-name> [--songs-dir DIR] [--relink]" >&2
    exit 2
fi

# Default the songs root to this repo's parent, which is the layout SETUP.md describes.
# Never inside the scaffold: nested git repos cause trouble, and song content must not
# land in a repo that gets shared.
if [ -z "$songs_dir" ]; then
    songs_dir="$(dirname "$SCAFFOLD")"
fi
songs_dir="$(cd "$songs_dir" 2>/dev/null && pwd)" || {
    echo "ERROR: songs directory does not exist: $songs_dir" >&2
    exit 1
}

target="$songs_dir/$song"

case "$target" in
    "$SCAFFOLD"/*)
        echo "ERROR: refusing to create a track repo inside the scaffold repo." >&2
        echo "  Scaffold: $SCAFFOLD" >&2
        echo "  Target:   $target" >&2
        exit 1 ;;
esac

echo "Scaffold: $SCAFFOLD"
echo "Track repo: $target"
echo

# ---------------------------------------------------------------------------
# Files. Created only when absent, so a re-run never clobbers written work.
# ---------------------------------------------------------------------------

created=0
kept=0

place() {   # place <source> <destination>
    if [ -e "$2" ]; then
        kept=$((kept + 1))
    else
        mkdir -p "$(dirname "$2")"
        cp "$1" "$2"
        created=$((created + 1))
        echo "  created $(basename "$2")"
    fi
}

if [ "$relink_only" -eq 0 ]; then
    mkdir -p "$target"

    for f in "$SCAFFOLD"/templates/song/*.md; do
        name="$(basename "$f")"
        [ "$name" = "README.md" ] && continue    # that one documents the templates
        place "$f" "$target/$name"
    done

    # templates/song/mix/ mirrors into the track repo's mix/ folder.
    for f in "$SCAFFOLD"/templates/song/mix/*.md; do
        [ -e "$f" ] || continue
        place "$f" "$target/mix/$(basename "$f")"
    done

    # The track repo's own CLAUDE.md, with the song name and scaffold path filled in.
    # This is what a Claude Code session started in the track repo reads first.
    if [ ! -e "$target/CLAUDE.md" ]; then
        sed -e "s|{{SONG}}|$song|g" -e "s|{{SCAFFOLD}}|$SCAFFOLD|g" \
            "$SCAFFOLD/templates/track-repo/CLAUDE.md" > "$target/CLAUDE.md"
        created=$((created + 1))
        echo "  created CLAUDE.md"
    else
        kept=$((kept + 1))
    fi

    # Every category pull.py can file a part under. Keep this list in step with
    # pull.py's CATEGORY_MAP: a category pull.py emits but new-song has not created is
    # a folder that appears out of nowhere on the first pull.
    for d in parts/drums parts/percussion parts/bass parts/guitars parts/keys \
             parts/vocals parts/fx chain mix; do
        mkdir -p "$target/$d"
        [ -e "$target/$d/.gitkeep" ] || touch "$target/$d/.gitkeep"
    done

    if [ ! -e "$target/.gitignore" ]; then
        cat > "$target/.gitignore" <<'GITIGNORE'
# Generated by /pull from the Ableton session, which is the source of truth.
# Committing these means a large churning diff on every pull, for data that
# rebuilds in seconds. Folders are kept by .gitkeep.
parts/**/*.md
chain/*.md
mix/*.png

# Symlinks into the scaffold repo, rebuilt by `bin/new-song <name> --relink`.
# Not committed: the scaffold's path differs per machine.
.claude/

.DS_Store
*.als
*.alc
*.asd
GITIGNORE
        created=$((created + 1))
        echo "  created .gitignore"
    else
        kept=$((kept + 1))
    fi

    if [ ! -d "$target/.git" ]; then
        git -C "$target" init -q
        echo "  created git repo"
    fi
fi

# ---------------------------------------------------------------------------
# Wiring. Rebuilt every run, so an edited agent in the scaffold takes effect
# immediately in every track repo and the two can never drift.
#
# Per-file symlinks inside real directories, rather than one symlinked directory:
# a directory listing sees ordinary entries and each read follows its link.
# ---------------------------------------------------------------------------

linked=0
for kind in agents commands; do
    rm -rf "$target/.claude/$kind"
    mkdir -p "$target/.claude/$kind"
    for f in "$SCAFFOLD/.claude/$kind"/*.md; do
        [ -e "$f" ] || continue
        ln -sf "$f" "$target/.claude/$kind/$(basename "$f")"
        linked=$((linked + 1))
    done
done

# The bridge scripts are run by path, so record where they are for the session.
ln -sfn "$SCAFFOLD" "$target/.claude/scaffold"

echo
if [ "$relink_only" -eq 1 ]; then
    echo "Re-linked $linked agent and command files."
else
    echo "$created file(s) created, $kept left alone, $linked agent and command files linked."
fi

echo
echo "Next:"
echo "  1. cd $target"
echo "  2. Fill in brief.md and structure.md. Every agent reads them first."
echo "  3. export ABLETON_SONGS_DIR=$songs_dir"
echo "  4. Start Claude Code there. It reads CLAUDE.md and picks up the linked agents."
echo "  5. With Ableton open, run /pull to capture the session."
echo
echo "After cloning this track repo on another machine, re-run:"
echo "  <scaffold>/bin/new-song $song --relink"
